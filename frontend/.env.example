# Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# FOR LOCAL DEVELOPMENT: Create a file named exactly ".env.local" in the
# frontend/ directory and paste these values with your actual data.
#
# FOR PRODUCTION (Vercel/Netlify): Add these in the hosting dashboard under
# "Environment Variables" — DO NOT upload .env files to the server.
# ─────────────────────────────────────────────────────────────────────────────

# Your deployed backend API URL (e.g. from Render)
# Leave empty during local dev — Vite proxy handles it automatically
VITE_API_URL=https://your-backend-name.onrender.com

# Google OAuth Client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Analytics 4 (GA4) Measurement ID
VITE_GA_MEASUREMENT_ID=G-KNM0S28F9W
