# NQTCoder Backend Environment Configuration Example
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nqtcoder
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
NODE_ENV=development
# Production value → https://www.nqtcoder.dev  (set this in Render Dashboard)
# Local value      → http://localhost:5173
CLIENT_URL=http://localhost:5173

# Default Admin Setup (Required to seed/access the admin dashboard)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SelectAStrongPassword123!

# Email Configurations (Gmail SMTP / API / Fallbacks for Registration OTP Verification)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Resend API configuration (requires Resend API key)
# RESEND_API_KEY=re_your_resend_api_key

# Brevo API configuration (requires Brevo API key and sender)
# BREVO_API_KEY=xkeysib-your_brevo_api_key
# BREVO_SENDER_EMAIL=support@nqtcoder.dev

# Code Runner Configuration
# Options: 'local' (runs compilers on host machine) or 'judge0' (runs via Judge0 API sandbox)
RUN_MODE=local

# Java 8 local bin path (Only set locally on Windows if JDK is not in your system PATH. MUST be left blank/commented out on Render/Linux)
# JAVA_8_BIN=C:\Program Files\Java\jdk-1.8\bin
